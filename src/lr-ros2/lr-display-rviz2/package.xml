<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>lr_display_rviz2</name>
    <version>5.4.1</version>
    <description>"lr_display_rviz2" is a ROS 2 package to visualize in RVIZ2 the information from the "zed_wrapper" node</description>
    <maintainer email="support@stereolabs.com">STEREOLABS</maintainer>
    <license>Apache License 2.0</license>
    <url type="website">https://www.stereolabs.com/</url>
    <url type="repository">https://github.com/stereolabs/zed-ros2-wrapper</url>
    <url type="bugtracker">https://github.com/stereolabs/zed-ros2-wrapper/issues</url>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <build_depend>ament_cmake_auto</build_depend>
    <build_depend>qtbase5-dev</build_depend>

    <depend>pluginlib</depend>
    <depend>rclcpp</depend>
    <depend>rviz_common</depend>
    <depend>std_srvs</depend>
    <depend>zed_msgs</depend>

    <exec_depend>rviz2</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>zed_wrapper</exec_depend>
    <exec_depend>zed_description</exec_depend>
    <exec_depend>zed_components</exec_depend>
    <exec_depend>grid_map_rviz_plugin</exec_depend>
    <exec_depend>lr_terrain_geometry</exec_depend>
    <exec_depend>lr_segmentation</exec_depend>
    <exec_depend>lr_future_path</exec_depend>
    <exec_depend>lr_path_prediction</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <test_depend>ament_cmake_clang_format</test_depend>
    <test_depend>ament_cmake_pytest</test_depend>
    
    <export>
        <build_type>ament_cmake</build_type>
        <rviz_common plugin="${prefix}/plugin_description.xml"/>
    </export>
</package>
