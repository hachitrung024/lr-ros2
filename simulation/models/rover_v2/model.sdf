<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rover_v2">
    <static>false</static><self_collide>false</self_collide><allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <pose>0 0 0.34 0 0 0</pose>
      <inertial>
        <!-- Estimated values: replace with measured mass / CoG before hardware correlation. -->
        <pose>0 0 -0.06 0 0 0</pose><mass>92</mass>
        <inertia><ixx>8.30</ixx><iyy>18.90</iyy><izz>23.40</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.02 0 0 0</pose><geometry><box><size>1.30 0.76 0.34</size></box></geometry>
        <surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface>
      </collision>
      <visual name="rover_1_1_visual">
        <!-- The OBJ is X-forward but exported upside-down. Roll pi restores Z-up. -->
        <pose>-0.49359 0 -0.05361 3.141592654 0 0</pose>
        <geometry><mesh><uri>model://rover_v2/meshes/rover-1-1.obj</uri><scale>0.0113633 0.0106383 0.0114068</scale></mesh></geometry>
      </visual>
      <sensor name="chassis_contact" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate><topic>/model/rover_v2/contact/chassis</topic>
        <contact><collision>chassis_collision</collision></contact>
      </sensor>
      <sensor name="imu" type="imu">
        <always_on>true</always_on><update_rate>100</update_rate><topic>/model/rover_v2/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0002</bias_mean><bias_stddev>0.0001</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0002</bias_mean><bias_stddev>0.0001</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0002</bias_mean><bias_stddev>0.0001</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0.01</bias_mean><bias_stddev>0.005</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0.01</bias_mean><bias_stddev>0.005</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0.01</bias_mean><bias_stddev>0.005</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <visual name="zed_2i_body"><pose>0.70 0 0.20 0 0 0</pose><geometry><box><size>0.10 0.18 0.05</size></box></geometry></visual>
      <sensor name="zed_left" type="camera">
        <pose>0.74 0.06 0.20 0 0.139626 0</pose><always_on>true</always_on><update_rate>20</update_rate><topic>/zed2i/left/image</topic>
        <camera><camera_info_topic>/zed2i/left/camera_info</camera_info_topic><horizontal_fov>1.919862</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.15</near><far>40</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera>
      </sensor>
      <sensor name="zed_right" type="camera">
        <pose>0.74 -0.06 0.20 0 0.139626 0</pose><always_on>true</always_on><update_rate>20</update_rate><topic>/zed2i/right/image</topic>
        <camera><camera_info_topic>/zed2i/right/camera_info</camera_info_topic><horizontal_fov>1.919862</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.15</near><far>40</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera>
      </sensor>
      <sensor name="zed_depth" type="rgbd_camera">
        <pose>0.74 0.06 0.20 0 0.139626 0</pose><always_on>true</always_on><update_rate>20</update_rate><topic>/zed2i/rgbd</topic>
        <camera><camera_info_topic>/zed2i/rgbd/camera_info</camera_info_topic><horizontal_fov>1.919862</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.15</near><far>40</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></camera>
      </sensor>
    </link>

    <link name="left_track">
      <pose>0 0.43 0.17 0 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.07</ixx><iyy>0.68</iyy><izz>0.68</izz></inertia></inertial>
      <collision name="track_collision"><geometry><box><size>1.34 0.15 0.24</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.65</mu2><fdir1>1 0 0</fdir1></ode></friction></surface><max_contacts>60</max_contacts></collision>
      <sensor name="left_track_contact" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
        <topic>/model/rover_v2/contact/left_track</topic><contact><collision>track_collision</collision></contact></sensor>
    </link>
    <link name="right_track">
      <pose>0 -0.43 0.17 0 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.07</ixx><iyy>0.68</iyy><izz>0.68</izz></inertia></inertial>
      <collision name="track_collision"><geometry><box><size>1.34 0.15 0.24</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.65</mu2><fdir1>1 0 0</fdir1></ode></friction></surface><max_contacts>60</max_contacts></collision>
      <sensor name="right_track_contact" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
        <topic>/model/rover_v2/contact/right_track</topic><contact><collision>track_collision</collision></contact></sensor>
    </link>
    <joint name="left_track_joint" type="fixed"><parent>base_link</parent><child>left_track</child></joint>
    <joint name="right_track_joint" type="fixed"><parent>base_link</parent><child>right_track</child></joint>
    <plugin filename="gz-sim-tracked-vehicle-system" name="gz::sim::systems::TrackedVehicle">
      <left_track><link>left_track</link></left_track><right_track><link>right_track</link></right_track>
      <tracks_separation>0.86</tracks_separation><tracks_height>0.34</tracks_height><steering_efficiency>0.52</steering_efficiency>
      <topic>/model/rover_v2/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController"><link>left_track</link><min_velocity>-2</min_velocity><max_velocity>2</max_velocity></plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController"><link>right_track</link><min_velocity>-2</min_velocity><max_velocity>2</max_velocity></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions><odom_publish_frequency>100</odom_publish_frequency><odom_topic>/model/rover_v2/ground_truth</odom_topic>
    </plugin>
  </model>
</sdf>
